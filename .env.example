# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these under Project Settings → Environment Variables for Preview and Production.
# They will be used only by the contact form's API route (/api/contact, not built yet); the rest of
# the site runs without them.

# Resend API key (resend.com → API Keys). Server-only; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Inbox that receives inquiry form messages (S&A Creations' inquiry email, still to be confirmed).
CONTACT_TO_EMAIL=

# Sender address. Previews: Resend's test sender, "S&A Creations <onboarding@resend.dev>", which only
# delivers to the Resend account owner's inbox. Production: an address on the site's domain once it's
# chosen and verified in Resend.
CONTACT_FROM_EMAIL=

# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these under Project Settings → Environment Variables for Preview and Production.
# Only the inquiry form's API route (/api/contact) reads them; the rest of the site runs without them.

# Resend API key (resend.com → API Keys), with sending access to sacustomcreations.com.
# Server-only; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Inbox that receives inquiry form messages. Today: sayra@alvaradolegacyconsultingllc.com (the same address
# as email in content/site.ts; change both when the inbox moves). Several inboxes: comma-separated.
CONTACT_TO_EMAIL=

# Sender, on the domain verified in Resend (resend.com → Domains → sacustomcreations.com must say Verified):
# S&A Creations <inquiries@sacustomcreations.com>
# The visitor's address goes in Reply-To, so replying to an inquiry email answers the visitor.
CONTACT_FROM_EMAIL=
